<?xml version="1.0"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
    <!ENTITY wm "https://wintermute.local/ontology/world#" >
]>
<rdf:RDF xmlns="https://wintermute.local/ontology/world#"
     xml:base="https://wintermute.local/ontology/world"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:wm="https://wintermute.local/ontology/world#">

    <owl:Ontology rdf:about="https://wintermute.local/ontology/world"/>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="https://wintermute.local/ontology/world#hasTenet"/>
    <owl:ObjectProperty rdf:about="https://wintermute.local/ontology/world#governs"/>

    <!-- Classes -->
    <owl:Class rdf:about="https://wintermute.local/ontology/world#Entity"/>

    <owl:Class rdf:about="https://wintermute.local/ontology/world#SentientEntity">
        <rdfs:subClassOf rdf:resource="https://wintermute.local/ontology/world#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="https://wintermute.local/ontology/world#Agent">
        <rdfs:subClassOf rdf:resource="https://wintermute.local/ontology/world#SentientEntity"/>
    </owl:Class>

    <owl:Class rdf:about="https://wintermute.local/ontology/world#Action"/>

    <owl:Class rdf:about="https://wintermute.local/ontology/world#EthicalAction">
        <rdfs:subClassOf rdf:resource="https://wintermute.local/ontology/world#Action"/>
    </owl:Class>

    <owl:Class rdf:about="https://wintermute.local/ontology/world#ProhibitedAction">
        <rdfs:subClassOf rdf:resource="https://wintermute.local/ontology/world#Action"/>
    </owl:Class>

    <owl:Class rdf:about="https://wintermute.local/ontology/world#Tenet"/>

    <owl:Class rdf:about="https://wintermute.local/ontology/world#DignityTenet">
        <rdfs:subClassOf rdf:resource="https://wintermute.local/ontology/world#Tenet"/>
    </owl:Class>

    <owl:Class rdf:about="https://wintermute.local/ontology/world#JusticeTenet">
        <rdfs:subClassOf rdf:resource="https://wintermute.local/ontology/world#Tenet"/>
    </owl:Class>

    <!-- SubClassOf axioms for 10 foundational claims -->

    <!-- AC1: SentientEntity is a kind of Entity -->
    <!-- (already encoded above via rdfs:subClassOf) -->

    <!-- AC2: Agent is a kind of SentientEntity -->
    <!-- (already encoded above) -->

    <!-- AC3: EthicalAction is a kind of Action -->
    <!-- (already encoded above) -->

    <!-- AC4: ProhibitedAction is a kind of Action -->
    <!-- (already encoded above) -->

    <!-- AC5: DignityTenet is a kind of Tenet -->
    <!-- (already encoded above) -->

    <!-- AC6: JusticeTenet is a kind of Tenet -->
    <!-- (already encoded above) -->

    <!-- AC7: Equivalent classes — well-formed -->
    <owl:Class rdf:about="https://wintermute.local/ontology/world#ForbiddenAction">
        <owl:equivalentClass rdf:resource="https://wintermute.local/ontology/world#ProhibitedAction"/>
    </owl:Class>

    <!-- AC8: governs domain restriction -->
    <owl:Class rdf:about="https://wintermute.local/ontology/world#TenetHolder">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://wintermute.local/ontology/world#hasTenet"/>
                <owl:someValuesFrom rdf:resource="https://wintermute.local/ontology/world#Tenet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- AC9: disjoint classes -->
    <rdf:Description rdf:about="https://wintermute.local/ontology/world#EthicalAction">
        <owl:disjointWith rdf:resource="https://wintermute.local/ontology/world#ProhibitedAction"/>
    </rdf:Description>

    <!-- AC10: SubClassOf chain for agent hierarchy -->
    <owl:Class rdf:about="https://wintermute.local/ontology/world#FederationAgent">
        <rdfs:subClassOf rdf:resource="https://wintermute.local/ontology/world#Agent"/>
    </owl:Class>

</rdf:RDF>
