#!/usr/bin/env bash
# stub: returns correct verdict but always wrong-rule for testing wrong_rule counter
# Usage: <stub> check --owl <owl> --action <path> --format json --explain

set -euo pipefail

action_path=""
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--action" ]]; then
        action_path="$2"
        shift 2
    else
        shift
    fi
done

case_dir=$(dirname "${action_path:-/dev/null}")
case_name=$(basename "$case_dir")

if [[ "$case_name" == deny-* ]]; then
    echo '{"verdict":"deny","rule":"wrong-rule","axioms":[]}'
elif [[ "$case_name" == flag-* ]]; then
    echo '{"verdict":"flag","rule":"wrong-rule","axioms":[]}'
else
    echo '{"verdict":"allow","rule":"wrong-rule","axioms":[]}'
fi
